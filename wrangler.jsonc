{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess4fun",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "single-page-app",
    "not_found_handling": "single-page-app"
  }
}
